# ═══════════════════════════════════════════════════════════════════════════════
# Chicken Town SL — Production & Local Environment Configuration
# Tagline: SWIT U MOT SWIT U LYF
# ═══════════════════════════════════════════════════════════════════════════════

# ── App & Brand Configuration ──────────────────────────────────────────────────
# The canonical public URL of your deployed application or local server
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand display name and tagline
NEXT_PUBLIC_BRAND_NAME="Chicken Town SL"
NEXT_PUBLIC_BRAND_TAGLINE="SWIT U MOT SWIT U LYF"

# ── Supabase Backend & Database ────────────────────────────────────────────────
# Project URL found in your Supabase dashboard (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key for client-side queries and Realtime subscriptions
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret Service Role key for backend webhooks, admin tasks, and system bypass
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Monime Payment Gateway (Sierra Leone Leones - SLE) ─────────────────────────
# Monime API Access Token (Bearer token generated in Monime Merchant Portal)
MONIME_ACCESS_TOKEN=monime_live_sk_...

# Monime Merchant Space ID (UUID of the merchant space for Chicken Town SL)
MONIME_SPACE_ID=space_ct_sl_...

# Monime Webhook Signing Secret to verify incoming payment notifications
MONIME_WEBHOOK_SECRET=whsec_monime_...

# Optional override for Monime API base URL (defaults to https://api.monime.io/v1)
# MONIME_API_BASE_URL=https://api.monime.io/v1

# ── Meta WhatsApp Cloud API (Graph API v26.0) ──────────────────────────────────
# WhatsApp Business Phone Number ID (from Meta App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=100000000000000

# Meta Permanent System User Access Token with whatsapp_business_messaging permissions
WHATSAPP_ACCESS_TOKEN=EAAG...

# Secret verification token you define in Meta App Dashboard for Webhook handshake
WHATSAPP_VERIFY_TOKEN=chicken_town_sl_wa_verify_token_2024

# Meta App Secret (from App Settings -> Basic) for validating X-Hub-Signature-256 HMAC
WHATSAPP_APP_SECRET=0123456789abcdef0123456789abcdef

# ── Central Delivery Hub Configuration ─────────────────────────────────────────
# 392 Central Delivery & Dispatch Hub ID
DELIVERY_HUB_BRANCH_ID=b1000000-0000-0000-0000-000000000007
DELIVERY_HUB_BRANCH_SLUG=392
